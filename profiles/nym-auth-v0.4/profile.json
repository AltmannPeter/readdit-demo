{
  "$schema": "../schema/profile.schema.json",
  "id": "nym-auth-v0.4",
  "label": "nym_auth v0.4",
  "rulebook": {
    "title": "Nym-authentication Attestation Specification and Rulebook",
    "version": "0.4",
    "date": "2026-10-20",
    "document": "docs/nym_auth_rulebook.md"
  },
  "source": {
    "repository": "https://github.com/AltmannPeter/readdit-demo",
    "commit": "2e3c11bc308765f76efb3abf5e6fc01da15e7cf5"
  },
  "credential": {
    "id": "nym_auth",
    "label": "Age and pseudonym",
    "encodings": {
      "mso_mdoc": {
        "doctype": "eu.europa.ec.eudi.nym_auth.1",
        "attributes": [
          { "id": "birth_date", "role": "value", "presence": "required", "description": "full-date, CBOR tag 1004; input to age_check" },
          { "id": "ssc", "role": "commitment", "opens": ["secret_seed"], "presence": "required", "description": "SHA-256(secret_seed), the issuer-known seed" },
          { "id": "psc", "role": "commitment", "opens": ["private_seed"], "presence": "optional", "description": "SHA-256(private_seed), the issuer-unknown seed" }
        ]
      },
      "bbs_cd": {
        "schema_id": "eu.europa.ec.eudi.nym_auth.bbs.1",
        "schema_digest": "ab4183a9ed0b57d6bfb8994c92b432bb9731a3e2fd974ac2f67422e2f7dfb7e1",
        "attributes": [
          { "id": "device_key", "role": "hidden", "description": "P-256 device key, attested for hashed ECDSA" },
          { "id": "birth_date", "role": "hidden", "description": "date-packed" },
          { "id": "secret_seed", "role": "hidden", "description": "hash_to_scalar(secret_seed, \"nym_auth/v1/bbs-seed\")" }
        ]
      }
    }
  },
  "functions": {
    "pseudonym": {
      "kind": "value",
      "return": "nym",
      "wire": "pseudonym.config@1",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "required": ["config", "ver", "prf"],
        "properties": {
          "config": { "type": "string" },
          "ver": { "const": 1 },
          "prf": { "enum": ["sha-256", "hashdh-bls12381g1"] },
          "verifier_context": { "type": "string", "minLength": 1 }
        }
      },
      "meaning": "A pseudonym for this verifier, from the seed the configuration names.",
      "translation": [
        "Verifier: verifier_input = SHA-256(verifier_id) (sha-256) or UTF-8(verifier_id) (hashdh-bls12381g1), verifier_id = client_id.",
        "Wallet: the same, from the validated Request Object."
      ],
      "proof": "The pseudonym in results is derived from the seed the credential commits to.",
      "source_attributes": { "mso_mdoc": ["ssc"], "bbs_cd": ["secret_seed"] }
    },
    "age_check": {
      "kind": "value",
      "return": "age",
      "wire": "age.birth-date-bounds@1",
      "bounds_date": "request",
      "params": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "ge": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "le": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      },
      "meaning": "The holder was born on or after ge and on or before le.",
      "translation": [
        "Verifier: computes ge and le from the community's age gate and its UTC date, and sends them.",
        "Wallet: compares its birth date with ge and le as sent."
      ],
      "proof": "ge <= birth_date <= le; results[age] = true.",
      "source_attributes": { "mso_mdoc": ["birth_date"], "bbs_cd": ["birth_date"] }
    }
  },
  "pseudonym_configs": [
    {
      "id": "known-offender-matching-ssc",
      "seed": "secret_seed",
      "seed_attribute": { "mso_mdoc": "ssc", "bbs_cd": "secret_seed" },
      "prf": { "mso_mdoc": "sha-256", "bbs_cd": "hashdh-bls12381g1" },
      "requested": true,
      "properties": { "distinctPerVerifier": true, "sameAcrossVerifiers": false, "issuerCanLink": true, "knownOffenderMatching": true }
    },
    {
      "id": "known-offender-matching-psc",
      "seed": "private_seed",
      "seed_attribute": { "mso_mdoc": "psc" },
      "prf": { "mso_mdoc": "sha-256" },
      "properties": { "distinctPerVerifier": true, "sameAcrossVerifiers": false, "issuerCanLink": false, "knownOffenderMatching": true }
    },
    {
      "id": "account-recovery-ssc",
      "seed": "secret_seed",
      "seed_attribute": { "mso_mdoc": "ssc" },
      "prf": { "mso_mdoc": "sha-256" },
      "properties": { "distinctPerVerifier": true, "sameAcrossVerifiers": false, "issuerCanLink": true, "knownOffenderMatching": true }
    },
    {
      "id": "user-managed-pseudonym-xsite-ssc",
      "seed": "secret_seed",
      "seed_attribute": { "mso_mdoc": "ssc" },
      "prf": { "mso_mdoc": "sha-256" },
      "properties": { "distinctPerVerifier": false, "sameAcrossVerifiers": true, "issuerCanLink": false, "knownOffenderMatching": false }
    }
  ],
  "systems": [
    { "proof_system": "vega-v1", "system_id": "urn:circuits:vega:nym_auth:v1", "status": "available", "proof_time": "always" },
    { "proof_system": "longfellow-libzk-v1", "system_id": "urn:circuits:longfellow:nym_auth:v1", "status": "available", "proof_time": "always" },
    { "proof_system": "bbs-cd-plugins-v0.1", "system_id": "urn:mms:bbs-cd:nym_auth:v1", "status": "available", "proof_time": "never" }
  ]
}
