{
  // GitHub Codespaces: builds the same image as docker compose (Dockerfile) and runs the site in it.
  // The image's own command starts Community on port 3000; Codespaces forwards it over HTTPS.
  "name": "Community demo",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "features": {
    "ghcr.io/devcontainers/features/git:1": { "version": "os-provided" }
  },
  // The runtime image has no CA certificates; git in the codespace needs them to reach GitHub.
  "postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends ca-certificates",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Community", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["TRY-IT.md"] }
  }
}
