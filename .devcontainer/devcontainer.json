{
  // GitHub Codespaces: builds the same image as docker compose (Dockerfile) and runs the site in it.
  // The image's own command starts Readdit on port 3000; Codespaces forwards it over HTTPS.
  "name": "Readdit demo",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "overrideCommand": false,
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "features": {
    "ghcr.io/devcontainers/features/git:1": { "version": "os-provided" }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Readdit", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["TRY-IT.md"] }
  }
}
