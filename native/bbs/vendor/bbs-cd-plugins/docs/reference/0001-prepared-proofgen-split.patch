diff --git a/examples/prepared_probe.rs b/examples/prepared_probe.rs
new file mode 100644
index 0000000..e9f68aa
--- /dev/null
+++ b/examples/prepared_probe.rs
@@ -0,0 +1,48 @@
+//! Byte-equality and latency of the proposed ProofPrepare/complete split.
+use bbs_cd::interface::{KeyGen, PrecomputeCommitment, ProofGen, ProofVerify, SkToPk, Sign};
+use bbs_cd::mock_rng::ProfileRng;
+use bbs_cd::params::Ciphersuite;
+use bbs_cd::prepared::ProofPrepare;
+use bbs_cd::types::{Index, Message, MessageType, ScalarInput, COMMIT, DISCLOSE, HIDE, OCTETS, SCALAR};
+use std::time::Instant;
+
+fn limb(v: u128) -> ScalarInput { let mut b = [0u8; 32]; b[16..].copy_from_slice(&v.to_be_bytes()); ScalarInput(b) }
+
+fn main() {
+    let suite = Ciphersuite::Sha256;
+    let sk = KeyGen(suite, &[7u8; 32], b"", None).unwrap();
+    let pk = SkToPk(sk).unwrap();
+    let mut msgs: Vec<Message> = [1u128, 2, 3, 4].iter().map(|&v| Message::Scalar(limb(v << 100))).collect();
+    for a in [&b"Alice"[..], b"1990-01-01", b"age_over_18:true", b"SE"] { msgs.push(Message::Octets(a.to_vec())); }
+    let types: Vec<MessageType> = vec![SCALAR, SCALAR, SCALAR, SCALAR, OCTETS, OCTETS, OCTETS, OCTETS];
+    let header = b"devbind-p256-limbs-v0".to_vec();
+    let sig = Sign(suite, sk, &pk, &header, &msgs, &types).unwrap();
+    let disc = vec![COMMIT, COMMIT, COMMIT, COMMIT, HIDE, HIDE, DISCLOSE, HIDE];
+    let ph = b"verifier-context-or-devbind-digest";
+    // byte equality with the same mocked stream
+    let mk = || ProfileRng::new(suite, b"3.141592653589793238462643383279".to_vec(), b"probe-dst".to_vec(), vec![]);
+    let mut r1 = mk(); let mut r2 = mk();
+    let (a, _) = ProofGen(suite, &pk, &sig, &header, ph, &msgs, &types, &disc, None, Some(&mut r1)).unwrap();
+    let b = ProofPrepare(suite, &pk, &sig, &header, &msgs, &types, &disc, None, Some(&mut r2)).unwrap().complete(ph).unwrap();
+    assert_eq!(a, b, "prepared split must be byte-identical to ProofGen");
+    let mut r3 = mk();
+    let c = ProofPrepare(suite, &pk, &sig, &header, &msgs, &types, &disc, None, Some(&mut r3)).unwrap().complete_fast(ph).unwrap();
+    assert_eq!(a, c, "fast path must be byte-identical to ProofGen");
+    println!("byte-identical to ProofGen: ok ({} bytes)", a.len());
+    // latency
+    let idx: Vec<Index> = (0u64..4).map(Index::from).collect();
+    let n = 50; let mut prep = vec![]; let mut onl = vec![];
+    for _ in 0..n {
+        let (_c, rands) = PrecomputeCommitment(suite, &msgs[..4], &idx, &types, None).unwrap();
+        let t = Instant::now();
+        let st = ProofPrepare(suite, &pk, &sig, &header, &msgs, &types, &disc, Some(&rands), None).unwrap();
+        prep.push(t.elapsed().as_secs_f64() * 1e3);
+        let coms = st.commitments().to_vec();
+        let t = Instant::now();
+        let proof = st.complete_fast(ph).unwrap();
+        onl.push(t.elapsed().as_secs_f64() * 1e3);
+        ProofVerify(suite, &pk, &proof, &header, ph, &[msgs[6].clone()], &coms, &types, &disc).unwrap();
+    }
+    prep.sort_by(|a, b| a.partial_cmp(b).unwrap()); onl.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    println!("ProofPrepare p50 {:.2} ms | complete(ph) p50 {:.3} ms p95 {:.3} ms (n={n})", prep[n/2], onl[n/2], onl[n*95/100]);
+}
